{
  "manifest_version": 2,
  "id": "local.maimai.bilibili-plugin",
  "version": "0.5.0",
  "name": "麦麦刷B站插件",
  "description": "通过 Firefox MCP 浏览B站，并兼容只读 Bilibili MCP，并调用模型生成 B站回想、写入长期记忆",
  "author": {
    "name": "umouyoumou-del",
    "url": "https://github.com/umouyoumou-del"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/umouyoumou-del/maibot-bilibili-mcp"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": ">=17.4.1,<18.0.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "json-repair",
      "version_spec": ">=0.60.1,<0.61"
    },
    {
      "type": "python_package",
      "name": "mcp",
      "version_spec": ">=1.0.0,<2.0.0"
    }
  ],
  "capabilities": [
    "llm.generate",
    "memory.ingest_summary",
    "send.text",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
